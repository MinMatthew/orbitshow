{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minmatthew.github.io/orbitshow/schema/ranks.schema.json",
  "title": "Orbitshow ranking document (ranks/<cc>.json and ranks/world.json)",
  "description": "Netflix Top 10 ranking merged with TMDb metadata. Netflix supplies rank, title and weeks in the Top 10; TMDb supplies rating, genres, poster and synopsis. `tmdb` is null when a title could not be matched.",
  "type": "object",
  "required": ["schema", "scope", "country", "week", "updatedAt", "sources", "lists"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "scope": { "enum": ["country", "world"] },
    "country": { "type": ["string", "null"], "pattern": "^[a-z]{2}$", "description": "ISO 3166-1 alpha-2, lowercase; null for world." },
    "week": { "type": "string", "format": "date", "description": "Netflix week-ending date (Sunday)." },
    "updatedAt": { "type": "string", "format": "date-time", "description": "When this file's content last changed." },
    "sources": {
      "type": "object",
      "required": ["netflix", "tmdb"],
      "properties": {
        "netflix": {
          "type": "object",
          "required": ["name", "url", "week", "fetchedAt"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "week": { "type": "string", "format": "date" },
            "fetchedAt": { "type": "string", "format": "date-time" }
          }
        },
        "tmdb": {
          "type": "object",
          "required": ["name", "url"],
          "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
        }
      }
    },
    "lists": {
      "type": "object",
      "required": ["tv", "film"],
      "additionalProperties": false,
      "properties": {
        "tv": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/entry" } },
        "film": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/entry" } }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["rank", "type", "netflix", "tmdb", "availability"],
      "additionalProperties": false,
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
        "type": { "enum": ["tv", "film"] },
        "netflix": {
          "type": "object",
          "required": ["title", "seasonTitle", "weeksInTop10"],
          "properties": {
            "title": { "type": "string", "description": "Title exactly as Netflix publishes it (English)." },
            "seasonTitle": { "type": ["string", "null"], "description": "TV only: the season/part that ranked." },
            "weeksInTop10": { "type": "integer", "minimum": 0 },
            "hoursViewed": { "type": "integer", "description": "World only." },
            "views": { "type": "integer", "description": "World only: hours viewed / runtime." },
            "english": { "type": "boolean", "description": "World only: from the English-language list." }
          }
        },
        "tmdb": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/tmdb" }]
        },
        "availability": {
          "type": "object",
          "required": ["netflixCountries"],
          "properties": {
            "netflixCountries": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z]{2}$" },
              "description": "Countries where the title is on Netflix: places it ranked this week plus TMDb flatrate providers (provider 8). Used to answer 'is it available in my country?'."
            }
          }
        }
      }
    },
    "tmdb": {
      "type": "object",
      "required": ["id", "mediaType", "title", "genreIds", "rating", "posterPath", "overview", "confidence"],
      "properties": {
        "id": { "type": "integer" },
        "mediaType": { "enum": ["tv", "movie"] },
        "title": { "type": "string" },
        "originalTitle": { "type": ["string", "null"] },
        "year": { "type": ["integer", "null"] },
        "genreIds": { "type": "array", "items": { "type": "integer" }, "description": "TMDb genre ids; names are localised in the app (genres.js)." },
        "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 10, "description": "TMDb vote_average, null while there are no votes." },
        "voteCount": { "type": "integer", "minimum": 0 },
        "posterPath": { "type": ["string", "null"], "description": "Appended to https://image.tmdb.org/t/p/<size>." },
        "runtime": { "type": ["integer", "null"], "description": "Minutes (films) or typical episode length (TV)." },
        "seasons": { "type": ["integer", "null"] },
        "overview": {
          "type": "object",
          "description": "Synopsis by UI language (en, ko, ja, zh, es, fr, de); missing languages fall back to en.",
          "additionalProperties": { "type": "string" }
        },
        "titles": {
          "type": "object",
          "description": "Localised titles by UI language.",
          "additionalProperties": { "type": "string" }
        },
        "trailers": {
          "type": "object",
          "description": "Official YouTube trailer ids by UI language; empty when there is none, and the app then hides the trailer button.",
          "additionalProperties": { "type": "string", "pattern": "^[\\w-]{11}$" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Title similarity of the chosen TMDb match." }
      }
    }
  }
}
